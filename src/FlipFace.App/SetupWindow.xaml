<Window x:Class="FlipFace.App.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlipFace setup" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="Set up FlipFace" FontSize="22" FontWeight="Bold" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,16"
                   Text="FlipFace uses two free drivers by Nefarius. Install any that are missing, then click Check again." />

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock x:Name="ViGEmIcon" DockPanel.Dock="Left" FontSize="20" Width="34" VerticalAlignment="Center" />
                <Button x:Name="ViGEmDownload" DockPanel.Dock="Right" Content="Download" VerticalAlignment="Center"
                        Margin="10,0,0,0" Click="ViGEmDownload_Click" />
                <StackPanel>
                    <TextBlock Text="ViGEmBus" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}" Text="Creates the virtual Xbox controller that games see." />
                    <TextBlock x:Name="ViGEmState" Margin="0,4,0,0" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock x:Name="HidHideIcon" DockPanel.Dock="Left" FontSize="20" Width="34" VerticalAlignment="Center" />
                <Button x:Name="HidHideDownload" DockPanel.Dock="Right" Content="Download" VerticalAlignment="Center"
                        Margin="10,0,0,0" Click="HidHideDownload_Click" />
                <StackPanel>
                    <TextBlock Text="HidHide" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Hides your real controller from games, so they don't get every press twice." />
                    <TextBlock x:Name="HidHideState" Margin="0,4,0,0" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock x:Name="RestartNote" Style="{StaticResource Muted}" Margin="0,4,0,0" Visibility="Collapsed"
                   Text="Restart your PC to finish installing. FlipFace will be ready after that." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Check again" Click="CheckAgain_Click" />
            <Button x:Name="StartButton" Content="Start FlipFace" FontWeight="SemiBold" IsDefault="True" Click="Start_Click" />
            <Button Content="Close" IsCancel="True" Margin="0" Click="Close_Click" />
        </StackPanel>
    </StackPanel>
</Window>
