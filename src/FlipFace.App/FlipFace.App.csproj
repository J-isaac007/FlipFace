<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FlipFace.Core\FlipFace.Core.csproj" />
    <ProjectReference Include="..\FlipFace.Input\FlipFace.Input.csproj" />
    <ProjectReference Include="..\FlipFace.Output\FlipFace.Output.csproj" />
    <ProjectReference Include="..\FlipFace.Setup\FlipFace.Setup.csproj" />
    <ProjectReference Include="..\FlipFace.Runtime\FlipFace.Runtime.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); everything else is WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FlipFace</AssemblyName>
    <ApplicationIcon>FlipFace.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>FlipFace</Product>
    <Description>Remaps a controller's buttons and shows games a virtual Xbox 360 controller.</Description>
    <Copyright>Copyright (c) 2026 J-isaac007. MIT License.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WinForms types out of scope so names like Button and Application mean the WPF ones. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
